<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="new_car">

  <!-- Core kinematics, visuals, and collision geometry -->
  <xacro:include filename="$(find new_car_description)/urdf/robot_core.xacro"/>

  <!-- Gazebo Harmonic simulation plugins and sensors -->
  <xacro:include filename="$(find new_car_description)/urdf/gazebo.xacro"/>

  <!-- ROS 2 Control hardware interfaces -->
  <xacro:include filename="$(find new_car_description)/urdf/ros2_control.xacro"/>

</robot>
